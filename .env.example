# =============================================================================
# Whisper Court - Environment Configuration Template
# =============================================================================

# --- Backend Configuration ---
# Groq API Key (Required for autonomous AI agent dialogue and trust evaluation)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Identifier (Optional, defaults to qwen/qwen-2.5-32b or qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Server Binding (Optional, defaults to 0.0.0.0 and port 8000)
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (Optional, comma-separated list of origins for production)
# e.g., https://whispercourt.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend Configuration (Vite) ---
# Optional: Set if frontend and backend are hosted on separate domains/ports.
# In local development, the frontend dynamically auto-detects the backend hostname.
# VITE_API_URL=https://api.whispercourt.example.com
# VITE_WS_URL=wss://api.whispercourt.example.com
