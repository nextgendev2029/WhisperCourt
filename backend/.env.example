# =============================================================================
# Whisper Court - Backend Environment Configuration Template
# =============================================================================

# Groq API Key (Required for live AI agent speeches and trust evaluations)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Identifier (Optional, defaults to qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Server Binding (Optional, defaults to 0.0.0.0 and port 8000)
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (Optional, comma-separated list of origins for production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
